{
  "name": "silverscript",
  "publisher": "IzioDev",
  "displayName": "SilverScript",
  "description": "Kaspa SilverScript",
  "version": "0.1.3",
  "repository": {
    "url": "https://github.com/kaspanet/silverscript",
    "directory": "extensions/vscode"
  },
  "license": "ISC",
  "author": {
    "name": "Kaspa Developers"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:silverscript",
    "onDebug:silverscript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "silverscript.debug.runCurrentContract",
        "title": "SilverScript: Run Debugger for Current Contract"
      },
      {
        "command": "silverscript.tests.generate",
        "title": "SilverScript: Generate Boundary Tests"
      },
      {
        "command": "silverscript.debug.configureLaunch",
        "title": "SilverScript: Configure & Launch"
      }
    ],
    "keybindings": [
      {
        "command": "silverscript.debug.configureLaunch",
        "key": "f5",
        "when": "editorLangId == silverscript && !inDebugMode"
      }
    ],
    "debuggers": [
      {
        "type": "silverscript",
        "label": "SilverScript Debug",
        "languages": [
          "silverscript"
        ],
        "breakpoints": [
          {
            "language": "silverscript"
          }
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "scriptPath": {
                "type": "string",
                "description": "Path to SilverScript source file"
              },
              "testFile": {
                "type": "string",
                "description": "Path to sidecar test file (*.test.json)"
              },
              "testName": {
                "type": "string",
                "description": "Test case name from testFile"
              },
              "function": {
                "type": "string",
                "description": "Entrypoint function name"
              },
              "constructorArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "withoutSelector": {
                "type": "boolean",
                "default": false
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "silverscript",
            "request": "launch",
            "name": "SilverScript: Debug Contract",
            "scriptPath": "${file}",
            "stopOnEntry": true
          },
          {
            "type": "silverscript",
            "request": "launch",
            "name": "SilverScript: Debug Test Case",
            "testFile": "${file}",
            "testName": "",
            "stopOnEntry": true
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "silverscript",
        "aliases": [
          "SilverScript",
          "silverscript"
        ],
        "extensions": [
          ".sil"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "breakpoints": [
      {
        "language": "silverscript"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "SilverScript",
      "properties": {
        "silverscript.covenantsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable covenants-only opcodes."
        },
        "silverscript.withoutSelector": {
          "type": "boolean",
          "default": false,
          "description": "Compile without function selector (single entrypoint)."
        },
        "silverscript.maxDiagnostics": {
          "type": "number",
          "default": 200,
          "description": "Maximum diagnostics to report per document."
        },
        "silverscript.enableSemanticTokens": {
          "type": "boolean",
          "default": true,
          "description": "Enable semantic tokens from the LSP."
        },
        "silverscript.debugger.cargoCommand": {
          "type": "string",
          "default": "cargo run -p cli-debugger --",
          "description": "Shell command used to launch the Rust SilverScript debugger."
        },
        "silverscript.debugger.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments appended before command-specific debugger arguments."
        },
        "silverscript.debugger.terminalName": {
          "type": "string",
          "default": "SilverScript Debugger",
          "description": "Terminal name for debugger runs."
        },
        "silverscript.debugger.useDedicatedTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Reuse a dedicated terminal for debugger runs."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "1.108.1",
    "@vscode/test-cli": "0.0.12",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "npm-run-all": "4.1.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "web-tree-sitter": "0.26.3"
  }
}
